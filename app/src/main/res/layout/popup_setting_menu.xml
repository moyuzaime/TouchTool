<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="188dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="?attr/defaultPadding">

        <LinearLayout
            android:id="@+id/rowHelpDoc"
            style="@style/Theme.TouchTool.PopupMenuRow">

            <ImageView
                style="@style/Theme.TouchTool.PopupMenuIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_help" />

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:text="@string/setting_help_doc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowHelpVideo"
            style="@style/Theme.TouchTool.PopupMenuRow">

            <ImageView
                style="@style/Theme.TouchTool.PopupMenuIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_videocam" />

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:text="@string/setting_help_video" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="?attr/defaultPadding"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:id="@+id/rowAutoCapture"
            style="@style/Theme.TouchTool.PopupMenuRow">

            <ImageView
                style="@style/Theme.TouchTool.PopupMenuIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_screen_record" />

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:text="@string/setting_auto_give_capture_permission" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowRestrictedSettings"
            style="@style/Theme.TouchTool.PopupMenuRow">

            <ImageView
                style="@style/Theme.TouchTool.PopupMenuIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_lock_open" />

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:text="@string/setting_give_restricted_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLog"
            style="@style/Theme.TouchTool.PopupMenuRow">

            <ImageView
                style="@style/Theme.TouchTool.PopupMenuIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_note_stack" />

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:text="@string/app_setting_log_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowRestartService"
            style="@style/Theme.TouchTool.PopupMenuRow">

            <ImageView
                style="@style/Theme.TouchTool.PopupMenuIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_refresh" />

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:text="@string/app_setting_reload" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowAutoRestart"
            style="@style/Theme.TouchTool.PopupMenuRow"
            android:layout_width="match_parent">

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="10000dp"
                android:text="@string/app_setting_auto_reload" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoRestartSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAutoStart"
            style="@style/Theme.TouchTool.PopupMenuRow"
            android:layout_width="match_parent">

            <TextView
                style="@style/Theme.TouchTool.PopupMenuText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="10000dp"
                android:text="@string/app_setting_auto_start" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoStartSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
