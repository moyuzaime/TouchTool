<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="320dp"
    android:layout_height="400dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
    app:cardElevation="0dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/expandButton"
        style="?attr/iconButton"
        android:layout_marginStart="?attr/defaultPadding"
        app:icon="@drawable/icon_zoom_in_map" />

    <FrameLayout
        android:id="@+id/contentBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="168dp"
            android:orientation="vertical"
            android:paddingHorizontal="?attr/defaultPadding"
            android:paddingBottom="?attr/defaultOffset">

            <!-- 鏍囬鏍忥細宸︿袱涓寜閽€佷腑闂存爣棰樸€佸彸涓や釜鎸夐挳锛屼笉鍐嶇敤閲嶅彔瀹氫綅 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/iconButtonSize"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="?attr/iconButtonSize">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportButton"
                    style="?attr/iconButton"
                    app:icon="@drawable/icon_upload" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/title"
                    style="?attr/iconButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="?attr/defaultOffset"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearButton"
                    style="?attr/iconButton"
                    app:icon="@drawable/icon_delete" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/closeButton"
                    style="?attr/iconButton"
                    app:icon="@drawable/icon_close" />

            </LinearLayout>

            <!-- 鍒楄〃鍖猴細鍘绘帀鍐呭眰鍗＄墖鑳屾櫙锛屽彧淇濈暀涓€涓〃闈?-->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="?attr/defaultPadding"
                        android:clipToPadding="false"
                        android:paddingTop="?attr/defaultOffset"
                        android:paddingBottom="?attr/defaultOffset"
                        android:scrollbars="none"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/float_log_normal_item" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/emptyTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/log_empty_tips"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOutline"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- 鎼滅储鏍忥細绠ご骞舵帓锛屾悳绱㈤€夐」鏀惰繘鍙充晶鑿滃崟 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/defaultOffset"
                android:gravity="center_vertical"
                android:paddingEnd="?attr/smallIconButtonSize"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/searchBox"
                    style="?attr/textInputFilledStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundColor="?attr/colorSurfaceBright"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:endIconMode="clear_text"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:startIconDrawable="@drawable/icon_search"
                    app:startIconMinSize="?attr/iconButtonSize">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/searchEdit"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/iconButtonSize"
                        android:padding="0dp"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preButton"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="?attr/smallIconButtonSize"
                    android:layout_height="?attr/smallIconButtonSize"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/icon_keyboard_arrow_up"
                    app:iconSize="?attr/smallIconButtonSize" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextButton"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="?attr/smallIconButtonSize"
                    android:layout_height="?attr/smallIconButtonSize"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/icon_keyboard_arrow_down"
                    app:iconSize="?attr/smallIconButtonSize" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuButton"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="?attr/smallIconButtonSize"
                    android:layout_height="?attr/smallIconButtonSize"
                    android:contentDescription="@string/log_search_options"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/icon_more_horiz"
                    app:iconSize="?attr/smallIconButtonSize" />

            </LinearLayout>

            <!-- 鎼滅储閫夐」锛氱偣鍙充晶鑿滃崟鎸夐挳鎵嶅睍寮€锛屽钩鏃朵笉鍗犱綅缃?-->
            <com.google.android.material.button.MaterialButtonGroup
                android:id="@+id/searchOptionsBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="?attr/defaultOffset"
                android:layout_marginEnd="?attr/smallIconButtonSize"
                android:spacing="?attr/defaultOffset"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinyinCheck"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/fill_button_background_check"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/log_search_pinyin"
                    android:textSize="12sp"
                    android:minHeight="0dp"
                    android:paddingVertical="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/posCheck"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/fill_button_background_check"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/log_search_position"
                    android:textSize="12sp"
                    android:minHeight="0dp"
                    android:paddingVertical="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/caseCheck"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/fill_button_background_check"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/log_search_case"
                    android:textSize="12sp"
                    android:minHeight="0dp"
                    android:paddingVertical="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/regCheck"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/fill_button_background_check"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/log_search_regex"
                    android:textSize="12sp"
                    android:minHeight="0dp"
                    android:paddingVertical="6dp" />

            </com.google.android.material.button.MaterialButtonGroup>

        </LinearLayout>

        <!-- 缩放手柄贴在内容区右下角：随折叠一起隐藏，位置仍是整个窗口的右下角 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dragImage"
            android:layout_width="?attr/smallIconButtonSize"
            android:layout_height="?attr/smallIconButtonSize"
            android:layout_gravity="end|bottom"
            android:scaleType="centerInside"
            android:src="@drawable/icon_line_curve"
            android:tint="?attr/colorOutlineVariant" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>

